# =============================================================================
# Happy Cash — Positioning Questionnaire
# Copy this file to `.env` and fill the values. Never commit `.env`.
# =============================================================================

# ----- Server -----
NODE_ENV=production
PORT=3001

# Ports bound on the VPS host (loopback only — the host Nginx reverse-proxies).
# Change them if 8080 / 3001 collide with another service on the box.
WEB_HOST_PORT=8080
API_HOST_PORT=3001

# CORS origin(s) allowed to call the API (comma-separated). Must include the
# public origin the user sees in the browser.
CORS_ORIGINS=http://localhost:5173,https://printmarksgraphics.cloud

# ----- SMTP (Nodemailer) -----
# Examples:
#   Gmail:   smtp.gmail.com / 465 / SSL / app password
#   Brevo:   smtp-relay.brevo.com / 587 / STARTTLS
#   OVH:     ssl0.ovh.net / 465 / SSL
#   Resend:  smtp.resend.com / 465 / SSL / API key as password
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@happycash.example
SMTP_PASSWORD=changeme

# Display name + address used as the "From" of outgoing emails
MAIL_FROM_NAME=Happy Cash
MAIL_FROM_ADDRESS=noreply@happycash.example

# ----- Recipients -----
# Where every submission lands (the admin mailbox).
ADMIN_EMAIL=admin@happycash.example

# ----- Public frontend (Vite-exposed at build time) -----
# Sub-path prefix the SPA is served from. Empty / "/" for local dev or a
# dedicated subdomain. Use "/happycash/" when reverse-proxied under a sub-path.
VITE_BASE_PATH=/happycash/

# Public URL the browser uses to call the API. With the sub-path setup it is
# "/happycash/api". Leave "/api" for local dev (the Vite proxy handles it).
VITE_API_BASE_URL=/happycash/api

VITE_DEADLINE_ISO=2026-05-20T23:59:00+01:00
