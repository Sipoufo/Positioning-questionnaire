# =============================================================================
# Happy Cash — Positioning Questionnaire + Vote Module
# Copy this file to `.env` and fill the values. Never commit `.env`.
# =============================================================================

# ----- Server -----
NODE_ENV=production
PORT=3001

# Name of the Docker network used by Nginx Proxy Manager. NPM reaches our
# containers by name (hc-web, hc-api) over this shared network.
# Find it with: `docker network ls` (look for something ending in `_default`).
NPM_NETWORK=nginx-proxy-manager_default

# CORS origin(s) allowed to call the API (comma-separated). Must include the
# public origin the user sees in the browser.
CORS_ORIGINS=http://localhost:5173,https://printmarksgraphics.cloud

# ----- SMTP (Nodemailer) -----
# Examples:
#   Gmail:   smtp.gmail.com / 465 / SSL / app password
#   Brevo:   smtp-relay.brevo.com / 587 / STARTTLS
#   OVH:     ssl0.ovh.net / 465 / SSL
#   Resend:  smtp.resend.com / 465 / SSL / API key as password
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@happycash.example
SMTP_PASSWORD=changeme

# Display name + address used as the "From" of outgoing emails
MAIL_FROM_NAME=Happy Cash
MAIL_FROM_ADDRESS=noreply@happycash.example

# ----- Recipients -----
# Where every questionnaire submission lands (the admin mailbox).
ADMIN_EMAIL=admin@happycash.example

# ----- Public frontend (Vite-exposed at build time) -----
# Sub-path prefix the SPA is served from. Empty / "/" for local dev or a
# dedicated subdomain. Use "/happycash/" when reverse-proxied under a sub-path.
VITE_BASE_PATH=/happycash/

# Public URL the browser uses to call the API. With the sub-path setup it is
# "/happycash/api". Leave "/api" for local dev (the Vite proxy handles it).
VITE_API_BASE_URL=/happycash/api

VITE_DEADLINE_ISO=2026-05-20T23:59:00+01:00

# =============================================================================
# VOTE MODULE
# =============================================================================

# ----- PostgreSQL -----
# Internal Docker network only — no host port published. Another Postgres on
# the host can keep the default 5432 without conflict.
POSTGRES_USER=hc_vote
POSTGRES_PASSWORD=changeme_strong_random
POSTGRES_DB=happycash_vote

# Assembled by docker-compose. For local dev outside Docker, point to your
# local Postgres (e.g. postgresql://hc_vote:pwd@localhost:5433/happycash_vote).
DATABASE_URL=postgresql://hc_vote:changeme_strong_random@postgres:5432/happycash_vote

# ----- Anonymity master key -----
# Generate with: openssl rand -hex 32
# Used to encrypt per-vote secrets at rest. Rotate only on suspected compromise.
ANONYMITY_MASTER_KEY=replace_with_64_hex_chars_from_openssl_rand_hex_32

# ----- Vote module config -----
VOTE_MAGIC_LINK_TTL_HOURS=24
VOTE_SESSION_TTL_MINUTES=30
# Public URL the magic-link emails point to (must match the deployed frontend).
VOTE_BASE_URL=https://printmarksgraphics.cloud/happycash
