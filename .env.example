# =============================================================================
# Happy Cash — Positioning Questionnaire
# Copy this file to `.env` and fill the values. Never commit `.env`.
# =============================================================================

# ----- Server -----
NODE_ENV=production
PORT=3001

# Domain used by Caddy for the automatic HTTPS certificate.
# Set this to your real domain (e.g. positionnement.happycash.example).
DOMAIN=positionnement.example.com

# CORS origin(s) allowed to call the API (comma-separated). In production this
# should be the same host as DOMAIN (e.g. https://positionnement.example.com).
CORS_ORIGINS=http://localhost:5173,https://positionnement.example.com

# ----- SMTP (Nodemailer) -----
# Examples:
#   Gmail:   smtp.gmail.com / 465 / SSL / app password
#   Brevo:   smtp-relay.brevo.com / 587 / STARTTLS
#   OVH:     ssl0.ovh.net / 465 / SSL
#   Resend:  smtp.resend.com / 465 / SSL / API key as password
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@happycash.example
SMTP_PASSWORD=changeme

# Display name + address used as the "From" of outgoing emails
MAIL_FROM_NAME=Happy Cash
MAIL_FROM_ADDRESS=noreply@happycash.example

# ----- Recipients -----
# Where every submission lands (the admin mailbox).
ADMIN_EMAIL=admin@happycash.example

# ----- Public frontend (Vite-exposed) -----
# Variables prefixed VITE_ are exposed to the browser at build time.
VITE_API_BASE_URL=/api
VITE_DEADLINE_ISO=2026-05-20T23:59:00+01:00
